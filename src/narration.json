[
  {
    "id": "s01_a",
    "scene": 0,
    "at": 15,
    "text": "コケコッコー！ にわとりさんが、卵を産んだよ。"
  },
  {
    "id": "s01_b",
    "scene": 0,
    "at": 285,
    "text": "卵は、どこから出てきたのかな？"
  },
  { "id": "s01_c", "scene": 0, "at": 390, "text": "おしり？" },
  {
    "id": "s01_d",
    "scene": 0,
    "at": 465,
    "text": "あたり！ 卵は、おしりの穴から出てくるんだ。"
  },
  {
    "id": "s01_e",
    "scene": 0,
    "at": 605,
    "text": "でも、おなかの中で、どうやってできるのかな？"
  },
  {
    "id": "s02_a",
    "scene": 1,
    "at": 15,
    "text": "にわとりさんの、おなかの中を、のぞいてみよう！"
  },
  {
    "id": "s02_b",
    "scene": 1,
    "at": 165,
    "text": "ここは、黄身のおへや。卵の黄色いところ、黄身が育つよ。"
  },
  {
    "id": "s02_c",
    "scene": 1,
    "at": 325,
    "text": "黄身は、ながーいトンネルを通って、おしりの穴へ進むんだ。"
  },
  {
    "id": "s03_a",
    "scene": 2,
    "at": 15,
    "text": "黄身のおへやには、小さな黄身がいっぱい。ぶどうみたい！"
  },
  {
    "id": "s03_b",
    "scene": 2,
    "at": 175,
    "text": "にわとりさんがごはんを食べると、だんだん大きくなるよ。"
  },
  {
    "id": "s03_c",
    "scene": 2,
    "at": 335,
    "text": "大きくなった黄身が、ころん！ トンネルに入ったよ。"
  },
  {
    "id": "s04_a",
    "scene": 3,
    "at": 30,
    "text": "トンネルの中で、黄身のまわりに、白身がくっつくよ。"
  },
  {
    "id": "s04_b",
    "scene": 3,
    "at": 235,
    "text": "くるくるまわりながら、どんどん白身がふえるんだ。"
  },
  {
    "id": "s05_a",
    "scene": 4,
    "at": 20,
    "text": "つぎは、うすい皮で、ふわっとつつむよ。"
  },
  {
    "id": "s05_b",
    "scene": 4,
    "at": 250,
    "text": "ゆで卵の殻をむくと、うすい皮があるよね。あれだよ！"
  },
  {
    "id": "s06_a",
    "scene": 5,
    "at": 20,
    "text": "さいごのおへやで、かたい殻をつくるよ。"
  },
  {
    "id": "s06_b",
    "scene": 5,
    "at": 175,
    "text": "殻をつくるのは、とっても時間がかかる。夜のあいだ、ずーっとつくるんだ。"
  },
  {
    "id": "s06_c",
    "scene": 5,
    "at": 505,
    "text": "こんこん。かちかち！ 殻ができた！"
  },
  {
    "id": "s07_a",
    "scene": 6,
    "at": 20,
    "text": "にわとりさんは、ごはんをつんつん。貝殻の粉も食べるよ。"
  },
  {
    "id": "s07_b",
    "scene": 6,
    "at": 255,
    "text": "食べたごはんが、かたい殻のもとになるんだ。"
  },
  { "id": "s08_a", "scene": 7, "at": 15, "text": "いよいよ、おしりの穴へ。" },
  {
    "id": "s08_b",
    "scene": 7,
    "at": 155,
    "text": "じつは、ここは、うんちと同じ穴なんだ。"
  },
  {
    "id": "s08_c",
    "scene": 7,
    "at": 275,
    "text": "でも、卵が出るときは、うんちの道はおやすみ。だから卵はきれいなんだよ。"
  },
  {
    "id": "s08_d",
    "scene": 7,
    "at": 500,
    "text": "うーん…ぽんっ！ 卵が生まれた！"
  },
  {
    "id": "s09_a",
    "scene": 8,
    "at": 40,
    "text": "ふりかえってみよう。黄身、白身、うすい皮、そして殻。"
  },
  {
    "id": "s09_b",
    "scene": 8,
    "at": 335,
    "text": "ぜんぶで、だいたい一日。だから、にわとりさんは、一日にひとつくらい、卵を産むんだよ。"
  },
  {
    "id": "s10_a",
    "scene": 9,
    "at": 15,
    "text": "お母さんどりが、卵をぬくぬくあたためると…"
  },
  {
    "id": "s10_b",
    "scene": 9,
    "at": 330,
    "text": "ぱきっ…ぴよっ！ ひよこが生まれる卵もあるんだよ。"
  },
  {
    "id": "s10_c",
    "scene": 9,
    "at": 495,
    "text": "おうちで食べる卵は、ひよこにならない卵。卵って、すごいね！"
  }
]
