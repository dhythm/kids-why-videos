[
  {"id": "s01_a", "scene": 0, "at": 20, "text": "ねえねえ、夜のお空を見てごらん。まあるいお月さまが見えるね。"},
  {"id": "s01_b", "scene": 0, "at": 200, "text": "きょうは、ロケットに乗って、お月さままで行ってみよう！"},
  {"id": "s02_a", "scene": 1, "at": 12, "text": "お月さまって、どのくらい遠いのかな？"},
  {"id": "s02_b", "scene": 1, "at": 125, "text": "地球をならべて、かぞえてみよう。ひとつ、ふたつ、みっつ…どんどんならべて…"},
  {"id": "s02_c", "scene": 1, "at": 410, "text": "なんと、地球さんじゅっこぶん！ とーっても遠いんだね。"},
  {"id": "s03_a", "scene": 2, "at": 15, "text": "これが ロケット。"},
  {"id": "s03_b", "scene": 2, "at": 75, "text": "いちばん上のとんがったところに、宇宙飛行士さんが乗るんだよ。"},
  {"id": "s03_c", "scene": 2, "at": 225, "text": "その下は、ぜんぶ燃料のタンク。燃料をいっぱい入れて、パワーをためるよ。"},
  {"id": "s03_d", "scene": 2, "at": 420, "text": "そばのおうちとくらべると…でっかーい！"},
  {"id": "s04_a", "scene": 3, "at": 8, "text": "ロケットは、どうやって飛ぶのかな？ ふうせんで、ためしてみよう。"},
  {"id": "s04_b", "scene": 3, "at": 160, "text": "ぷしゅーっ！ 空気がうしろに出ると、ふうせんは前にすすむよ。"},
  {"id": "s04_c", "scene": 3, "at": 340, "text": "ロケットも同じ。"},
  {"id": "s04_d", "scene": 3, "at": 395, "text": "火とガスを、下にぶわーっと出すと…"},
  {"id": "s04_e", "scene": 3, "at": 505, "text": "その力で、上にびゅーんと飛んでいくんだ！"},
  {"id": "s05_a", "scene": 4, "at": 10, "text": "さあ、いよいよ発射だよ！"},
  {"id": "s05_c5", "scene": 4, "at": 92, "text": "ご！"},
  {"id": "s05_c4", "scene": 4, "at": 128, "text": "よん！"},
  {"id": "s05_c3", "scene": 4, "at": 164, "text": "さん！"},
  {"id": "s05_c2", "scene": 4, "at": 200, "text": "に！"},
  {"id": "s05_c1", "scene": 4, "at": 236, "text": "いち！"},
  {"id": "s05_go", "scene": 4, "at": 274, "text": "発射ー！"},
  {"id": "s05_b", "scene": 4, "at": 360, "text": "ゴゴゴゴ…ロケットが、お空にのぼっていくよ！"},
  {"id": "s05_d", "scene": 4, "at": 530, "text": "雲をぬけて、どんどん高く…宇宙へ！"},
  {"id": "s06_a", "scene": 5, "at": 10, "text": "燃料がからっぽになったタンクは、ぽいっと、すてちゃうよ。"},
  {"id": "s06_b", "scene": 5, "at": 255, "text": "もうひとつ、ぽいっ！"},
  {"id": "s06_c", "scene": 5, "at": 345, "text": "からだが軽くなって、もっとはやく飛べるんだ。"},
  {"id": "s07_a", "scene": 6, "at": 20, "text": "まずは、地球のまわりを、ぐるっとまわるよ。"},
  {"id": "s07_b", "scene": 6, "at": 160, "text": "まわりながら、お月さまにむかうタイミングを、まっているんだ。"},
  {"id": "s07_c", "scene": 6, "at": 335, "text": "いまだ！ エンジン、びゅーん！ お月さまへ出発！"},
  {"id": "s08_a", "scene": 7, "at": 30, "text": "お月さままでは、なんと、みっかもかかるんだよ。"},
  {"id": "s08_b", "scene": 7, "at": 315, "text": "ロケットの中では、からだがふわふわ浮くんだよ。お水も、パンも、ふわふわ〜。"},
  {"id": "s09a_a", "scene": 8, "at": 15, "text": "お月さまに、ついたよ！"},
  {"id": "s09a_b", "scene": 8, "at": 175, "text": "小さな着陸船で、おりていくよ。"},
  {"id": "s09b_a", "scene": 9, "at": 25, "text": "そーっと、そーっと…"},
  {"id": "s09b_b", "scene": 9, "at": 212, "text": "着陸！ やったね！"},
  {"id": "s09b_c", "scene": 9, "at": 285, "text": "宇宙飛行士さんが、お月さまにおりたよ。"},
  {"id": "s09b_d", "scene": 9, "at": 392, "text": "お月さまでは、からだがとっても軽いから…ぴょーん、ぴょーん！"},
  {"id": "s09b_e", "scene": 9, "at": 615, "text": "旗を立てて、やったー！"},
  {"id": "s10_a", "scene": 10, "at": 15, "text": "さあ、地球にかえろう！"},
  {"id": "s10_b", "scene": 10, "at": 152, "text": "空気の中に入ると、あつくなって、まっかっか！"},
  {"id": "s10_c", "scene": 10, "at": 290, "text": "パラシュートを、ぱっとひらいて…"},
  {"id": "s10_d", "scene": 10, "at": 405, "text": "ざっぶーん！ 海におりたよ。ただいま！"},
  {"id": "s10_e", "scene": 10, "at": 570, "text": "お月さまの旅、たのしかったね！ またね！"}
]
