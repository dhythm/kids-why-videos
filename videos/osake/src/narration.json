[
  {
    "id": "s01_a",
    "scene": 0,
    "at": 20,
    "text": "かんぱーい！ パパとママが、なにか飲んでるよ。"
  },
  {
    "id": "s01_b",
    "scene": 0,
    "at": 200,
    "text": "しゅわしゅわ…ジュースかな？"
  },
  {
    "id": "s01_c",
    "scene": 0,
    "at": 330,
    "text": "ううん、これは、お酒。おとなの飲みものなんだ。"
  },
  {
    "id": "s01_d",
    "scene": 0,
    "at": 500,
    "text": "お酒って、なんだろう？"
  },
  {
    "id": "s02_a",
    "scene": 1,
    "at": 15,
    "text": "お酒は、いろんなものからできるよ。"
  },
  { "id": "s02_b", "scene": 1, "at": 140, "text": "お米からは、日本酒。" },
  { "id": "s02_c", "scene": 1, "at": 260, "text": "ぶどうからは、ワイン。" },
  { "id": "s02_d", "scene": 1, "at": 380, "text": "麦からは、ビール。" },
  {
    "id": "s03_a",
    "scene": 2,
    "at": 15,
    "text": "お酒をつくる、ひみつのなかまがいるよ。"
  },
  {
    "id": "s03_b",
    "scene": 2,
    "at": 150,
    "text": "目に見えないくらい小さな生きもの、酵母さん！"
  },
  {
    "id": "s03_c",
    "scene": 2,
    "at": 320,
    "text": "酵母さんは、あまーいところを、ぱくぱく食べる。"
  },
  {
    "id": "s03_d",
    "scene": 2,
    "at": 480,
    "text": "すると、しゅわしゅわの泡と、アルコールが出てくるんだ。"
  },
  {
    "id": "s04_a",
    "scene": 3,
    "at": 20,
    "text": "なんにちも、なんにちも、ぷくぷく、ぷくぷく。"
  },
  {
    "id": "s04_b",
    "scene": 3,
    "at": 230,
    "text": "こうして、だんだんお酒になるんだ。これを、発酵っていうよ。"
  },
  {
    "id": "s05_a",
    "scene": 4,
    "at": 20,
    "text": "じつは、パンがふわふわにふくらむのも、酵母さんのおかげ。"
  },
  {
    "id": "s05_b",
    "scene": 4,
    "at": 230,
    "text": "泡で、ぷくーっとふくらむんだよ。"
  },
  {
    "id": "s06_a",
    "scene": 5,
    "at": 20,
    "text": "おとながお酒を飲むと、アルコールが、血といっしょに、からだじゅうをめぐるよ。"
  },
  {
    "id": "s06_b",
    "scene": 5,
    "at": 270,
    "text": "あたまに届くと、顔があかくなったり、ふわふわ、いい気分になったり。"
  },
  {
    "id": "s06_c",
    "scene": 5,
    "at": 490,
    "text": "ねむくなっちゃうことも、あるんだ。"
  },
  {
    "id": "s07_a",
    "scene": 6,
    "at": 20,
    "text": "おなかの中では、肝臓さんが、がんばってるよ。"
  },
  {
    "id": "s07_b",
    "scene": 6,
    "at": 180,
    "text": "アルコールを、えいっ、えいっと、こわしてくれるんだ。"
  },
  {
    "id": "s07_c",
    "scene": 6,
    "at": 390,
    "text": "でも、こわすのには、時間がかかる。だから、飲みすぎはだめなんだよ。"
  },
  {
    "id": "s08_a",
    "scene": 7,
    "at": 20,
    "text": "子どものからだは、まだ育っているとちゅう。"
  },
  {
    "id": "s08_b",
    "scene": 7,
    "at": 190,
    "text": "肝臓さんも小さくて、アルコールをうまくこわせないんだ。"
  },
  {
    "id": "s08_c",
    "scene": 7,
    "at": 390,
    "text": "だから、お酒は、二十歳になってから。子どもは飲んじゃだめ、なんだよ。"
  },
  {
    "id": "s09_a",
    "scene": 8,
    "at": 20,
    "text": "お酒の中には、ジュースみたいな見た目のものもあるよ。"
  },
  {
    "id": "s09_b",
    "scene": 8,
    "at": 230,
    "text": "わからないときは、飲むまえに、おうちの人にきいてね。"
  },
  {
    "id": "s10_a",
    "scene": 9,
    "at": 30,
    "text": "ふりかえってみよう。お米やぶどうを、酵母さんが食べて、お酒ができる。"
  },
  {
    "id": "s10_b",
    "scene": 9,
    "at": 330,
    "text": "お酒は、おとなの飲みもの。子どもは、ジュースで、かんぱーい！"
  }
]
