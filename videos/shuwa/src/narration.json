[
  {
    "id": "s01_a",
    "scene": 0,
    "at": 30,
    "text": "ほいくえんで、手話を ならったんだ！"
  },
  {
    "id": "s01_b",
    "scene": 0,
    "at": 130,
    "text": "見て！ これは、ありがとう。"
  },
  {
    "id": "s01_c",
    "scene": 0,
    "at": 290,
    "text": "でも、手話って、なんの ために あるのかな？"
  },
  {
    "id": "s02_a",
    "scene": 1,
    "at": 20,
    "text": "みんなは、耳で いろんな 音を 聞いているね。"
  },
  {
    "id": "s02_b",
    "scene": 1,
    "at": 140,
    "text": "ことりの こえ、すずの 音、ともだちの こえ。"
  },
  {
    "id": "s02_c",
    "scene": 1,
    "at": 290,
    "text": "でも、耳が 聞こえない人や、すこししか 聞こえない人も いるんだよ。"
  },
  {
    "id": "s03_a",
    "scene": 2,
    "at": 20,
    "text": "聞こえない人に、こえで「おーい！」って よんでも……"
  },
  {
    "id": "s03_b",
    "scene": 2,
    "at": 175,
    "text": "とどかないね。"
  },
  {
    "id": "s03_c",
    "scene": 2,
    "at": 260,
    "text": "どうしたら、おはなし できるかな？"
  },
  {
    "id": "s04_a",
    "scene": 3,
    "at": 20,
    "text": "そうだ！ 目で 見える ことばなら、つたわるね。"
  },
  {
    "id": "s04_b",
    "scene": 3,
    "at": 160,
    "text": "手と、かおで はなす ことば。それが、手話なんだ。"
  },
  {
    "id": "s05_a",
    "scene": 4,
    "at": 20,
    "text": "手話は、聞こえない人たちが みんなで つくって、だいじに そだててきた ことば。"
  },
  {
    "id": "s05_b",
    "scene": 4,
    "at": 220,
    "text": "日本語や 英語と おなじように、なんでも はなせるんだよ。"
  },
  {
    "id": "s06_a",
    "scene": 5,
    "at": 20,
    "text": "手話では、かおも だいじ。"
  },
  {
    "id": "s06_b",
    "scene": 5,
    "at": 110,
    "text": "うれしい ときは、にっこり わらって、手を うごかすよ。"
  },
  {
    "id": "s06_c",
    "scene": 5,
    "at": 250,
    "text": "かおも、ことばの なかまなんだね。"
  },
  {
    "id": "s07_a",
    "scene": 6,
    "at": 20,
    "text": "手話は、いろんな ところで つかわれているよ。"
  },
  {
    "id": "s07_b",
    "scene": 6,
    "at": 125,
    "text": "かぞくや ともだちと おしゃべり。テレビの ニュースでも、手話で つたえる人が いるね。"
  },
  {
    "id": "s07_c",
    "scene": 6,
    "at": 320,
    "text": "聞こえない子が かよう がっこうでも、手話で べんきょうするんだ。"
  },
  {
    "id": "s08_a",
    "scene": 7,
    "at": 20,
    "text": "手話は 目で 見る ことばだから、音が なくても つたわる。"
  },
  {
    "id": "s08_b",
    "scene": 7,
    "at": 175,
    "text": "うるさい ところや、まどの むこうにも、とどくよ。"
  },
  {
    "id": "s09_a",
    "scene": 8,
    "at": 20,
    "text": "聞こえない人と はなす ときは、かたを とんとん。手を ふって、気づいて もらおう。"
  },
  {
    "id": "s09_b",
    "scene": 8,
    "at": 225,
    "text": "かおを 見て、くちを はっきり うごかそう。みぶりや、字を かいても いいよ。"
  },
  {
    "id": "s10_a",
    "scene": 9,
    "at": 20,
    "text": "いっしょに やってみよう！"
  },
  {
    "id": "s10_b",
    "scene": 9,
    "at": 90,
    "text": "こんにちは。"
  },
  {
    "id": "s10_c",
    "scene": 9,
    "at": 230,
    "text": "ありがとう。"
  },
  {
    "id": "s11_a",
    "scene": 10,
    "at": 20,
    "text": "耳が 聞こえない人も いる。"
  },
  {
    "id": "s11_b",
    "scene": 10,
    "at": 110,
    "text": "手と かおで はなす ことば、それが 手話。"
  },
  {
    "id": "s11_c",
    "scene": 10,
    "at": 240,
    "text": "手話を つかえば、もっと たくさんの 人と なかよく なれるね。またね！"
  }
]
