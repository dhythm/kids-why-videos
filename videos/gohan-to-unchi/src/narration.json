[
  {
    "id": "s01_a",
    "scene": 0,
    "at": 15,
    "text": "いただきまーす！ もぐもぐ…おにぎり、おいしいね。"
  },
  {
    "id": "s01_b",
    "scene": 0,
    "at": 185,
    "text": "でも、食べたごはんは、おなかの中で、どうなるのかな？"
  },
  {
    "id": "s01_c",
    "scene": 0,
    "at": 350,
    "text": "じつは…さいごは、うんちになるんだよ！ なんでだろう？"
  },
  {
    "id": "s02_a",
    "scene": 1,
    "at": 15,
    "text": "食べものは、お口からおしりまで、ながーいトンネルを通っていくよ。"
  },
  {
    "id": "s02_b",
    "scene": 1,
    "at": 185,
    "text": "お口、しょくどう、いぶくろ、しょうちょう、だいちょう。"
  },
  {
    "id": "s02_c",
    "scene": 1,
    "at": 360,
    "text": "このトンネルをまっすぐのばすと…大人だと、なんとバスくらいの長さ！"
  },
  {
    "id": "s03_a",
    "scene": 2,
    "at": 15,
    "text": "まずは、お口。歯で、かみかみ…小さくするよ。"
  },
  {
    "id": "s03_b",
    "scene": 2,
    "at": 180,
    "text": "つばもまざって、やわらかくなるんだ。よーくかむと、おなかがらくちんだよ。"
  },
  { "id": "s03_c", "scene": 2, "at": 400, "text": "ごっくん！" },
  {
    "id": "s04_a",
    "scene": 3,
    "at": 20,
    "text": "のどのおくの、しょくどうが、ぎゅっ、ぎゅっと、いぶくろへはこぶよ。"
  },
  {
    "id": "s05_a",
    "scene": 4,
    "at": 15,
    "text": "いぶくろに、とうちゃく！ いぶくろは、ぐにゅぐにゅうごいて、まぜまぜ。"
  },
  {
    "id": "s05_b",
    "scene": 4,
    "at": 210,
    "text": "すっぱい、いえきで、ばいきんも、やっつけるよ。"
  },
  {
    "id": "s05_c",
    "scene": 4,
    "at": 355,
    "text": "なんじかんもかけて、食べものは、どろどろのスープみたいになるんだ。"
  },
  {
    "id": "s06_a",
    "scene": 5,
    "at": 20,
    "text": "つぎは、しょうちょう。ほそくて、とってもながい、くだだよ。"
  },
  {
    "id": "s06_b",
    "scene": 5,
    "at": 200,
    "text": "かべには、小さなひだが、いーっぱい。"
  },
  {
    "id": "s06_c",
    "scene": 5,
    "at": 320,
    "text": "ここで、からだにひつような、えいようを、どんどんすいとるよ。"
  },
  {
    "id": "s07_a",
    "scene": 6,
    "at": 15,
    "text": "すいとったえいようは、ちにのって、からだじゅうへ。"
  },
  {
    "id": "s07_b",
    "scene": 6,
    "at": 150,
    "text": "はしったり、かんがえたり、大きくなるための、パワーになるんだ！"
  },
  {
    "id": "s08_a",
    "scene": 7,
    "at": 15,
    "text": "のこったものは、だいちょうへ。"
  },
  {
    "id": "s08_b",
    "scene": 7,
    "at": 95,
    "text": "ここでは、おみずをすいとって、だんだん、かたくなっていくよ。"
  },
  {
    "id": "s08_c",
    "scene": 7,
    "at": 255,
    "text": "おなかの中には、小さななかまの、さいきんもいっぱい。のこりものをたべて、おてつだいしてくれるんだ。"
  },
  {
    "id": "s08_d",
    "scene": 7,
    "at": 515,
    "text": "こうして…うんちの、できあがり！"
  },
  {
    "id": "s09_a",
    "scene": 8,
    "at": 15,
    "text": "おなかが、でるよーって、おしえてくれたら、トイレへゴー！"
  },
  {
    "id": "s09_b",
    "scene": 8,
    "at": 200,
    "text": "すっきり！ ごはんがうんちになるまで、いちにちから、みっかくらいの、たびなんだ。"
  },
  {
    "id": "s10_a",
    "scene": 9,
    "at": 15,
    "text": "うんちは、からだからの、おてがみ。バナナみたいなうんちは、げんきなしるし！"
  },
  {
    "id": "s10_b",
    "scene": 9,
    "at": 230,
    "text": "やさいをたべて、おみずをのんで、いっぱいあそぼうね。"
  },
  { "id": "s10_c", "scene": 9, "at": 420, "text": "またね！" }
]
