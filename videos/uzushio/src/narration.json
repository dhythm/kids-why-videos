[
  {
    "id": "s01_a",
    "scene": 0,
    "at": 30,
    "text": "見て見て！ 海が、ぐるぐる まわってるよ！"
  },
  {
    "id": "s01_b",
    "scene": 0,
    "at": 170,
    "text": "これは、うずしお。海の水が まわって できる、大きな うずなんだ。"
  },
  {
    "id": "s01_c",
    "scene": 0,
    "at": 360,
    "text": "どうして、海の水が まわるのかな？"
  },
  {
    "id": "s02_a",
    "scene": 1,
    "at": 20,
    "text": "うずしおで ゆうめいなのは、鳴門海峡。"
  },
  {
    "id": "s02_b",
    "scene": 1,
    "at": 150,
    "text": "とくしまけんと、あわじしまの あいだにある、せまい海だよ。"
  },
  {
    "id": "s03_a",
    "scene": 2,
    "at": 20,
    "text": "うずしおの ひみつは、おつきさま。"
  },
  {
    "id": "s03_b",
    "scene": 2,
    "at": 120,
    "text": "おつきさまは、海の水を、ぐいーっと ひっぱるんだ。"
  },
  {
    "id": "s03_c",
    "scene": 2,
    "at": 280,
    "text": "だから 海の水は、ふえたり、へったり するよ。"
  },
  {
    "id": "s04_a",
    "scene": 3,
    "at": 20,
    "text": "鳴門海峡の こっちと あっちでは、水の たかさが ちがうことが あるんだ。"
  },
  {
    "id": "s04_b",
    "scene": 3,
    "at": 210,
    "text": "こっちは たかい。あっちは ひくい。"
  },
  {
    "id": "s05_a",
    "scene": 4,
    "at": 20,
    "text": "すると、たかい ほうから ひくい ほうへ、水が ざばーっと ながれる。"
  },
  {
    "id": "s05_b",
    "scene": 4,
    "at": 200,
    "text": "せまい ところを とおるから、とっても はやい！ じてんしゃ くらいの はやさなんだ。"
  },
  {
    "id": "s06_a",
    "scene": 5,
    "at": 20,
    "text": "まんなかの 水は、はやい。でも、はしっこの 水は、ゆっくり。"
  },
  {
    "id": "s06_b",
    "scene": 5,
    "at": 200,
    "text": "はやい 水と、ゆっくりの 水が、すれちがうと…"
  },
  {
    "id": "s06_c",
    "scene": 5,
    "at": 345,
    "text": "くるっ！ と まわって、うずが できるんだ。"
  },
  {
    "id": "s07_a",
    "scene": 6,
    "at": 20,
    "text": "おうちでも、ためせるよ。えんぴつを、りょうての あいだに はさんで、"
  },
  {
    "id": "s07_b",
    "scene": 6,
    "at": 185,
    "text": "てを、まえと うしろに、ずらしてみて。"
  },
  {
    "id": "s07_c",
    "scene": 6,
    "at": 300,
    "text": "えんぴつが、くるくる まわるね。うずしおと、おんなじ しくみだよ。"
  },
  {
    "id": "s08_a",
    "scene": 7,
    "at": 20,
    "text": "大きな うずしおは、バス 2だいぶん くらい！"
  },
  {
    "id": "s08_b",
    "scene": 7,
    "at": 150,
    "text": "はると あきの、おおしおの ころが、いちばん 大きく なるよ。"
  },
  {
    "id": "s09_a",
    "scene": 8,
    "at": 20,
    "text": "うずしおは、ふねや、はしの うえから 見ることが できるよ。"
  },
  {
    "id": "s09_b",
    "scene": 8,
    "at": 170,
    "text": "でも、ちかくで およいだりするのは、とっても あぶない。おうちの ひとと いっしょに 見てね。"
  },
  {
    "id": "s10_a",
    "scene": 9,
    "at": 30,
    "text": "おつきさまが、海の水を ひっぱって、"
  },
  {
    "id": "s10_b",
    "scene": 9,
    "at": 150,
    "text": "せまい ところを、水が はやく ながれて、"
  },
  {
    "id": "s10_c",
    "scene": 9,
    "at": 275,
    "text": "はやい水と、ゆっくりの水で、くるっ！ これが、うずしおの ひみつ でした！"
  }
]
