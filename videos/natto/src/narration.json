[
  {
    "id": "s01_a",
    "scene": 0,
    "at": 30,
    "text": "なっとうを、ぐるぐる まぜると…"
  },
  {
    "id": "s01_b",
    "scene": 0,
    "at": 150,
    "text": "ほら、ネバネバの いとが、のびーる！"
  },
  {
    "id": "s01_c",
    "scene": 0,
    "at": 320,
    "text": "なっとうは、どうして ネバネバ しているのかな？"
  },
  {
    "id": "s02_a",
    "scene": 1,
    "at": 20,
    "text": "なっとうの もとは、だいず という まめだよ。"
  },
  {
    "id": "s02_b",
    "scene": 1,
    "at": 160,
    "text": "でも、にた だいずは、ネバネバ しないね。"
  },
  {
    "id": "s02_c",
    "scene": 1,
    "at": 320,
    "text": "だれが、ネバネバに したんだろう？"
  },
  {
    "id": "s03_a",
    "scene": 2,
    "at": 20,
    "text": "まめを、ぐーんと おおきく してみよう。"
  },
  {
    "id": "s03_b",
    "scene": 2,
    "at": 150,
    "text": "いたいた！ めに みえない ちいさな いきもの、なっとうきん だよ。"
  },
  {
    "id": "s03_c",
    "scene": 2,
    "at": 340,
    "text": "むかしは、いねの わらに すんでいる なっとうきんで、なっとうを つくっていたんだ。"
  },
  {
    "id": "s04_a",
    "scene": 3,
    "at": 20,
    "text": "なっとうの つくりかたを みてみよう。"
  },
  {
    "id": "s04_b",
    "scene": 3,
    "at": 120,
    "text": "だいずを みずに つけて、やわらかく むしたら、なっとうきんを ぱらぱら。"
  },
  {
    "id": "s04_c",
    "scene": 3,
    "at": 330,
    "text": "あったかい へやで、いちにち くらい ねかせるよ。"
  },
  {
    "id": "s05_a",
    "scene": 4,
    "at": 20,
    "text": "なっとうきんは、だいずを もぐもぐ たべて、どんどん ふえるよ。"
  },
  {
    "id": "s05_b",
    "scene": 4,
    "at": 200,
    "text": "そして、だいずの まわりに、ネバネバを つくりだすんだ。"
  },
  {
    "id": "s05_c",
    "scene": 4,
    "at": 370,
    "text": "ネバネバは、なっとうきんが つくったものだったんだね。"
  },
  {
    "id": "s06_a",
    "scene": 5,
    "at": 20,
    "text": "ネバネバを、もっと おおきく してみよう。"
  },
  {
    "id": "s06_b",
    "scene": 5,
    "at": 140,
    "text": "うまみの もとの なかまが、てを つないで、ながーい くさりに なっているよ。"
  },
  {
    "id": "s06_c",
    "scene": 5,
    "at": 340,
    "text": "ながい くさりが からまりあって、のびーる いとに なるんだ。"
  },
  {
    "id": "s07_a",
    "scene": 6,
    "at": 20,
    "text": "なっとうきんは、どうして ネバネバを つくるのかな？"
  },
  {
    "id": "s07_b",
    "scene": 6,
    "at": 160,
    "text": "かわいたり、たべものが なくなったり したときに、じぶんを まもるため、と かんがえられているよ。"
  },
  {
    "id": "s07_c",
    "scene": 6,
    "at": 400,
    "text": "でも、まだ わからない ことも あって、はかせたちが しらべているんだ。"
  },
  {
    "id": "s08_a",
    "scene": 7,
    "at": 20,
    "text": "なっとうを まぜると、どうなるかな？"
  },
  {
    "id": "s08_b",
    "scene": 7,
    "at": 140,
    "text": "くさりが のびて、くうきも はいって、ふわふわの ネバネバに なるよ。"
  },
  {
    "id": "s08_c",
    "scene": 7,
    "at": 350,
    "text": "たくさん まぜると、いとも いっぱい！"
  },
  {
    "id": "s09_a",
    "scene": 8,
    "at": 20,
    "text": "だいずに、なっとうきんが すみついて…"
  },
  {
    "id": "s09_b",
    "scene": 8,
    "at": 150,
    "text": "もぐもぐ たべて、ネバネバの くさりを つくる。それが、なっとうの ネバネバ！"
  },
  {
    "id": "s09_c",
    "scene": 8,
    "at": 380,
    "text": "きょうも、なっとうを まぜまぜ して、たべてみてね。またね！"
  }
]
